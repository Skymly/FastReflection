<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net472 test leg consumes the library's net462 build, net6.0 consumes netstandard2.0 -->
    <TargetFrameworks>net472;net6.0;net8.0</TargetFrameworks>
    <!-- Test hosts roll forward to a newer runtime when the exact one is not installed -->
    <RollForward>LatestMajor</RollForward>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FastReflection\FastReflection.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Build-time only: lets net472 compile on machines without the targeting pack (CI) -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" Condition="'$(TargetFramework)' == 'net472'" />
  </ItemGroup>

</Project>
