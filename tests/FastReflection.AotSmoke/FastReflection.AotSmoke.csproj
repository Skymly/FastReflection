<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <!-- Published for linux-x64 and executed by the Nuke AotSmoke target. -->
    <PublishAot>true</PublishAot>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FastReflection\FastReflection.csproj" />
    <ProjectReference Include="..\..\src\FastReflection.ObjectReader\FastReflection.ObjectReader.csproj" />
    <ProjectReference Include="..\..\src\FastReflection.XmlDocs\FastReflection.XmlDocs.csproj" />
    <!-- XmlDocs smoke fixture: the scenario reads it through XmlDocsOptions.PathToXmlFile,
         which must work under PublishAot where Assembly.Location is empty. -->
    <Content Include="SmokeDocs.xml" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
