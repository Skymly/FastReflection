<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net462;netstandard2.0;net8.0</TargetFrameworks>
    <AssemblyName>FastReflection</AssemblyName>
    <RootNamespace>FastReflection</RootNamespace>
    <PackageId>Skymly.FastReflection</PackageId>
    <Version>0.1.0</Version>
    <Authors>Skymly</Authors>
    <Description>Reusable access over a runtime-known property, field, method, or constructor, and a type accessor for the instance properties and fields of a closed type. Falls back to reflection when dynamic code is unavailable. Supports .NET Framework 4.6.2+, .NET Core, and .NET 8+.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>reflection;emit;il;delegate;performance</PackageTags>
    <RepositoryUrl>https://github.com/Skymly/FastReflection</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- DynamicMethod/ILGenerator are in-box on net462 and net8.0; netstandard2.0 needs the packages -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Reflection.Emit.ILGeneration" Version="4.7.0" />
    <PackageReference Include="System.Reflection.Emit.Lightweight" Version="4.7.0" />
  </ItemGroup>

  <!-- Build-time only: lets net462 compile on machines without the .NET Framework targeting pack (CI) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net462'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FastReflection.Tests" />
  </ItemGroup>

</Project>
