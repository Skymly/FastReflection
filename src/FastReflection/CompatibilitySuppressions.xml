<?xml version="1.0" encoding="utf-8"?>
<!-- https://learn.microsoft.com/dotnet/fundamentals/package-validation/diagnostic-ids -->
<!-- Intentional per-TFM differences (docs/specs/1.0-quality-gates.md):
     the net8.0 asset gains the span invokers and their delegates — they are #if-gated
     to NET8_0_OR_GREATER because System.Span<object?> requires a modern BCL surface.
     Downlevel assets keep the object?[]-array invokers, which are the same accesses. -->
<Suppressions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <Suppression>
    <DiagnosticId>CP0001</DiagnosticId>
    <Target>T:FastReflection.FastSpanConstructorInvoker</Target>
    <Left>lib/netstandard2.0/FastReflection.dll</Left>
    <Right>lib/net8.0/FastReflection.dll</Right>
  </Suppression>
  <Suppression>
    <DiagnosticId>CP0001</DiagnosticId>
    <Target>T:FastReflection.FastSpanInvoker</Target>
    <Left>lib/netstandard2.0/FastReflection.dll</Left>
    <Right>lib/net8.0/FastReflection.dll</Right>
  </Suppression>
  <Suppression>
    <DiagnosticId>CP0002</DiagnosticId>
    <Target>M:FastReflection.ReflectionExtensions.CreateSpanInvoker(System.Reflection.ConstructorInfo)</Target>
    <Left>lib/netstandard2.0/FastReflection.dll</Left>
    <Right>lib/net8.0/FastReflection.dll</Right>
  </Suppression>
  <Suppression>
    <DiagnosticId>CP0002</DiagnosticId>
    <Target>M:FastReflection.ReflectionExtensions.CreateSpanInvoker(System.Reflection.MethodInfo)</Target>
    <Left>lib/netstandard2.0/FastReflection.dll</Left>
    <Right>lib/net8.0/FastReflection.dll</Right>
  </Suppression>
</Suppressions>
